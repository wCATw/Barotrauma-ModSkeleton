<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="../Build.props"/>

    <Target Name="RunSetupRefs" BeforeTargets="BeforeBuild">
        <Exec Command="python &quot;$(SolutionDir)Tools\setup_refs.py&quot; --building" />
    </Target>

    <PropertyGroup>
        <OutputPath>..\bin\Linux\Client</OutputPath>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <Reference Include="0Harmony">
        <HintPath>..\Refs\0Harmony.dll</HintPath>
        <Private>False</Private>
      </Reference>
      <Reference Include="Barotrauma">
        <HintPath>..\Refs\Linux\Barotrauma.dll</HintPath>
        <Private>False</Private>
      </Reference>
      <Reference Include="BarotraumaCore">
        <HintPath>..\Refs\Linux\BarotraumaCore.dll</HintPath>
        <Private>False</Private>
      </Reference>
      <Reference Include="Farseer.NetStandard">
        <HintPath>..\Refs\Farseer.NetStandard.dll</HintPath>
        <Private>False</Private>
      </Reference>
      <Reference Include="Lidgren.NetStandard">
        <HintPath>..\Refs\Lidgren.NetStandard.dll</HintPath>
        <Private>False</Private>
      </Reference>
      <Reference Include="Mono.Cecil">
        <HintPath>..\Refs\Mono.Cecil.dll</HintPath>
        <Private>False</Private>
      </Reference>
      <Reference Include="MonoGame.Framework.Linux.NetStandard">
        <HintPath>..\Refs\MonoGame.Framework.Linux.NetStandard.dll</HintPath>
        <Private>False</Private>
      </Reference>
      <Reference Include="MonoMod.Backports">
        <HintPath>..\Refs\MonoMod.Backports.dll</HintPath>
        <Private>False</Private>
      </Reference>
      <Reference Include="MonoMod.Iced">
        <HintPath>..\Refs\MonoMod.Iced.dll</HintPath>
        <Private>False</Private>
      </Reference>
      <Reference Include="MonoMod.ILHelpers">
        <HintPath>..\Refs\MonoMod.ILHelpers.dll</HintPath>
        <Private>False</Private>
      </Reference>
      <Reference Include="MonoMod.RuntimeDetour">
        <HintPath>..\Refs\MonoMod.RuntimeDetour.dll</HintPath>
        <Private>False</Private>
      </Reference>
      <Reference Include="MonoMod.Utils">
        <HintPath>..\Refs\MonoMod.Utils.dll</HintPath>
        <Private>False</Private>
      </Reference>
      <Reference Include="MoonSharp.Interpreter">
        <HintPath>..\Refs\MoonSharp.Interpreter.dll</HintPath>
        <Private>False</Private>
      </Reference>
      <Reference Include="XNATypes">
        <HintPath>..\Refs\XNATypes.dll</HintPath>
        <Private>False</Private>
      </Reference>
    </ItemGroup>

    <Import Project="..\SharedProject\SharedProject.projitems" Label="Shared" />

    <PropertyGroup>
        <RootNamespace>$(SolutionName.Replace(" ", "_"))</RootNamespace>
        <PlatformTarget>x64</PlatformTarget>
        <GenerateDocumentationFile>False</GenerateDocumentationFile>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <DefineConstants>TRACE;CLIENT;LINUX</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <DefineConstants>TRACE;CLIENT;LINUX</DefineConstants>
    </PropertyGroup>

    <Target Name="CopyFiles" AfterTargets="Build">
        <ItemGroup>
            <Assemblies Include="$(TargetDir)$(TargetName).dll" />
            <DepsFiles Include="$(TargetDir)$(TargetName).deps.json" />
        </ItemGroup>
        <Copy SourceFiles="@(Assemblies)" DestinationFiles="$(ModDeployDir)bin\Client\Linux\$(TargetName).dll" />
        <Copy SourceFiles="@(DepsFiles)" DestinationFiles="$(ModDeployDir)bin\Client\Linux\$(TargetName).deps.json" />
    </Target>
    
</Project>
